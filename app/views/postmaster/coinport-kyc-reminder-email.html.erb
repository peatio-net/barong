                                        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="padding: 0;">
                                            <tr>
                                              <td>
                                                <p style="font-size: 22px; line-height: 26px; font-weight: 600; padding: 0 0 20px;">Hi  <%= @user.email%>, complete your verification to unlock all features</p>
                                                
                                                <p style="font-size: 15px; font-weight: 400; padding: 0 0 20px;">You're just a few steps away from accessing all of CoinPort's features. Complete your KYC verification to:</p>

                                                <ul style="margin: 0 0 20px 0; padding-left: 20px;">
                                                    <li style="font-size: 15px; padding: 5px 0;">✓ Enable cryptocurrency deposits and withdrawals</li>
                                                    <li style="font-size: 15px; padding: 5px 0;">✓ Start trading cryptocurrencies</li>
                                                    <li style="font-size: 15px; padding: 5px 0;">✓ Access all trading pairs and markets</li>
                                                    <li style="font-size: 15px; padding: 5px 0;">✓ Send internal transfers to other users</li>
                                                </ul>
                                
                                                <!-- Progress Section -->
                                                <div style="background-color: #f8f9fa; border-radius: 8px; padding: 25px; margin: 0 0 20px;">
                                                    <h3 style="margin: 0; padding: 0 0 20px; color: #00233C;">Your Verification Progress</h3>
                                                    
                                                    <!-- Progress Bar -->
                                                    <div style="background-color: #e9ecef; border-radius: 10px; height: 12px; margin: 0 0 20px; position: relative;">
                                                        <div style="background-color: #1a6dff; border-radius: 10px; height: 12px; width: {{progress_percentage}}%;"></div>
                                                    </div>
                                                    
                                                    <p style="font-size: 16px; font-weight: 600; color: #1a6dff; margin: 0 0 20px; text-align: center;">{{completed_steps}} of 5 steps completed</p>
                                                    
                                                    <!-- Steps List -->
                                                    <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0;">
                                                        <tr>
                                                            <td style="padding: 10px 0; border-bottom: 1px solid #e9ecef;">
                                                                <span style="{{email_style}}"><%= @record[:statuses][0] %>Email Verification</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 10px 0; border-bottom: 1px solid #e9ecef;">
                                                                <span style="{{phone_style}}"><%= @record[:statuses][1] %> Phone Verification</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 10px 0; border-bottom: 1px solid #e9ecef;">
                                                                <span style="{{profile_style}}"><%= @record[:statuses][2] %>  Personal Details</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 10px 0; border-bottom: 1px solid #e9ecef;">
                                                                <span style="{{document_style}}"><%= @record[:statuses][3] %>  Identity Document</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 10px 0;">
                                                                <span style="{{address_style}}"><%= @record[:statuses][4] %> Address Verification</span>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>

                                                <!-- Next Step Highlight -->
                                                <div style="background-color: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; padding: 20px; margin: 0 0 20px;">
                                                    <h4 style="margin: 0; padding: 0 0 10px; color: #856404;">Next Step: <%= @record[:next_step] %></h4>
                                                    <p style="font-size: 14px; color: #856404; margin: 0;"><%= @record[:next_step_description] %></p>
                                                </div>
                                                
                                                <!-- Continue Button -->
                                                <div style="text-align: center; padding: 20px 0;">
                                                    <a href="www.coinport.com.au" style="display: inline-block; padding: 14px 40px; background-color: #1a6dff; color: white; text-decoration: none; border-radius: 6px; font-size: 16px; font-weight: 500;">Continue Verification</a>
                                                </div>

                                                <!-- Video Help Section -->
                                                <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 20px; margin: 20px 0; text-align: center;">
                                                    <p style="font-size: 16px; font-weight: 600; color: #00233a; margin: 0 0 10px;">Need help with verification?</p>
                                                    <p style="font-size: 14px; color: #6c757d; margin: 0 0 15px;">
                                                        Watch our step-by-step video guides on YouTube to make the KYC process quick and easy.
                                                    </p>
                                                    <a href="https://www.youtube.com/@CoinPortEx/videos" style="display: inline-block; padding: 10px 25px; background-color: #ff0000; color: white; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 500;">
                                                        <span style="vertical-align: middle;">▶</span> Watch Video Guides
                                                    </a>
                                                </div>

                                                <div style="background-color: #f0f8ff; border: 1px solid #cce5ff; border-radius: 8px; padding: 15px; margin: 20px 0;">
                                                    <p style="font-size: 14px; color: #004085; margin: 0 0 10px;">
                                                        <strong>Why do we need KYC?</strong>
                                                    </p>
                                                    <p style="font-size: 14px; color: #004085; margin: 0;">
                                                        KYC (Know Your Customer) verification helps us maintain a secure platform, comply with regulations, and protect your account from unauthorized access.
                                                    </p>
                                                </div>

                                                <p style="font-size: 14px; color: #6c757d; text-align: center; padding: 20px 0 0;">
                                                    Need help? Contact our support team at <a href="mailto:support@coinport.com.au" style="color: #1a6dff;">support@coinport.com.au</a>
                                                </p>
                                              </td>
                                            </tr>
